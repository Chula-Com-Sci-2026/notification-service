# Copy to .env and fill in. Outside ENVIRONMENT=local the app refuses to start
# while a value is still "changethis".

ENVIRONMENT=local

# Verifies Identity's access tokens, so all three must match Identity's values.
ACCESS_TOKEN_SECRET=changethis
JWT_ISSUER=cant-run-alone-local
JWT_AUDIENCE=cant-run-alone-services

# Host-side connection, used by `uv run`. compose.yaml overrides both for its
# own containers and publishes this port on IPv4 loopback only, so "localhost"
# would try IPv6 first, which made the test suite 50 times slower on Windows.
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=notification
POSTGRES_USER=notification
POSTGRES_PASSWORD=changethis

# Host-side broker connection, overridden the same way by compose.yaml.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5673
RABBITMQ_USER=notification
RABBITMQ_PASSWORD=changethis

# Loopback ports published by compose.yaml.
API_PORT=8010
RABBITMQ_MANAGEMENT_PORT=15673

# Error reporting; ignored when ENVIRONMENT=local.
SENTRY_DSN=
