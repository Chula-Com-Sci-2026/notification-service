# Copy to .env and fill in. Outside ENVIRONMENT=local the app refuses to start
# while a value is still "changethis".

ENVIRONMENT=local

# Host-side connection, used by `uv run`. compose.yaml overrides both for its
# own containers and publishes this port on loopback only.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_DB=notification
POSTGRES_USER=notification
POSTGRES_PASSWORD=changethis

RABBITMQ_USER=notification
RABBITMQ_PASSWORD=changethis

# Loopback ports published by compose.yaml.
API_PORT=8010
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

# Error reporting; ignored when ENVIRONMENT=local.
SENTRY_DSN=
